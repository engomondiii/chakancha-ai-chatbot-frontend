# ── Django Backend ──────────────────────────────────────────────────────────
# Point this at your running Django server
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Frontend URL ────────────────────────────────────────────────────────────
# Used for Chakan Tree referral links and OG metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Feature flags ───────────────────────────────────────────────────────────
# Set to true/false to enable or disable features
NEXT_PUBLIC_ENABLE_AI_CHAT=true
NEXT_PUBLIC_ENABLE_SEARCH=true
NEXT_PUBLIC_ENABLE_SUBSCRIPTIONS=false
NEXT_PUBLIC_ENABLE_IMAGE_GEN=false
NEXT_PUBLIC_ENABLE_WEB_SEARCH=false
NEXT_PUBLIC_ENABLE_CHAKAN_TREE=true

# ── Google Analytics (optional) ─────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=

# ── Production only (set these in Railway / Vercel environment variables) ───
# NEXT_PUBLIC_API_URL=https://your-railway-backend.up.railway.app
# NEXT_PUBLIC_SITE_URL=https://chakancha.com
# ── Payments ──────────────────────────────────────────────────────────────────
# Stripe is the card gateway. TWO keys are needed and they live in different
# places: the SECRET key on the Django server, which raises the PaymentIntent,
# and this PUBLISHABLE one here, which is what Stripe Elements needs in the
# browser to confirm the card. With only the server half set, the card field
# renders and can never be confirmed, so the checkout now hides the card option
# until this is present. Find it in the Stripe dashboard under Developers →
# API keys; it begins pk_test_ in sandbox and pk_live_ in production, and it is
# safe to ship to a browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# PayPal needs no key here. The buyer is sent to PayPal's own approval page,
# whose URL the backend creates with the server-side credentials, so nothing
# PayPal-related is exposed to the browser.
