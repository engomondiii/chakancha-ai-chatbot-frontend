# ── Django Backend ──────────────────────────────────────────────────────────
# Point this at your running Django server
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Frontend URL ────────────────────────────────────────────────────────────
# Used for Chakan Tree referral links and OG metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Feature flags ───────────────────────────────────────────────────────────
# Set to true/false to enable or disable features
NEXT_PUBLIC_ENABLE_AI_CHAT=true
NEXT_PUBLIC_ENABLE_SEARCH=true
NEXT_PUBLIC_ENABLE_SUBSCRIPTIONS=false
NEXT_PUBLIC_ENABLE_IMAGE_GEN=false
NEXT_PUBLIC_ENABLE_WEB_SEARCH=false
NEXT_PUBLIC_ENABLE_CHAKAN_TREE=true

# ── Google Analytics (optional) ─────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=

# ── Production only (set these in Railway / Vercel environment variables) ───
# NEXT_PUBLIC_API_URL=https://your-railway-backend.up.railway.app
# NEXT_PUBLIC_SITE_URL=https://chakancha.com